{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "grantId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "limit": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tokens",
        "costMicros",
        "turns"
      ],
      "additionalProperties": false
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "provider",
        "accounting"
      ]
    }
  },
  "required": [
    "channel",
    "operationId",
    "grantId",
    "limit",
    "enforcement"
  ],
  "additionalProperties": false,
  "title": "_axp/grant"
}
