{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "throughTurn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "maxLength": 24000
    },
    "decisions": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "activeFiles": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "required": [
    "channel",
    "operationId",
    "expectedRevision",
    "throughTurn",
    "summary",
    "decisions",
    "activeFiles"
  ],
  "additionalProperties": false,
  "title": "_axp/compact"
}
