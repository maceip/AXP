{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actions": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "channel",
    "operationId",
    "epoch",
    "actions"
  ],
  "additionalProperties": false,
  "title": "_axp/emit"
}
