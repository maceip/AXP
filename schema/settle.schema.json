{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "turnId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cacheReadTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "costMicros": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "type": "string",
              "enum": [
                "reported",
                "reservation"
              ]
            },
            "costSource": {
              "type": "string",
              "enum": [
                "reported",
                "reservation"
              ]
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "cacheReadTokens",
            "costMicros",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "cancelled",
        "error"
      ]
    },
    "error": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "channel",
    "operationId",
    "epoch",
    "turnId",
    "usage",
    "outcome"
  ],
  "additionalProperties": false,
  "title": "_axp/settle"
}
