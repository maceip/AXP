{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "trigger": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "lesson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "fromSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "channel",
    "operationId",
    "title",
    "trigger",
    "lesson",
    "outcome",
    "fromSeq",
    "toSeq"
  ],
  "additionalProperties": false,
  "title": "_axp/memoryPropose"
}
