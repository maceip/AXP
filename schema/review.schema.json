{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "repository": {
          "type": "string",
          "maxLength": 512
        },
        "session": {
          "type": "string",
          "maxLength": 256
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "promptHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "traceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "traceThroughSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "repository",
        "session",
        "baseCommit",
        "headCommit",
        "model",
        "promptHash",
        "traceHash",
        "traceThroughSeq",
        "checkpointDigest"
      ],
      "additionalProperties": false
    },
    "contributor": {
      "type": "object",
      "properties": {
        "publicKey": {
          "type": "string",
          "maxLength": 1024
        },
        "signature": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "publicKey",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "channel",
    "operationId",
    "manifest",
    "contributor"
  ],
  "additionalProperties": false,
  "title": "_axp/review"
}
