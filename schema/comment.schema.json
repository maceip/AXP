{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "channel",
    "operationId",
    "body",
    "checkpoint",
    "path"
  ],
  "additionalProperties": false,
  "title": "_axp/comment"
}
